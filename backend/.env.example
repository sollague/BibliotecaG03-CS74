# Configuración local del backend.
# Copia este archivo como backend/.env y reemplaza los valores.
# No publiques el archivo backend/.env real.

NODE_ENV=development
PORT=4000

# Cadena de conexión de Prisma a MySQL 8.
# La clave `biblioteca123` es la que crea database/biblioteca_g03.sql.
# Si la cambias en el script, actualízala también aquí.
DATABASE_URL="mysql://biblioteca:biblioteca123@127.0.0.1:3306/biblioteca_g03"

# Secreto de firma de sesiones. Debe tener al menos 32 caracteres.
JWT_SECRET="cambia_por_una_clave_aleatoria_de_al_menos_32_caracteres"
JWT_EXPIRES_IN=8h
COOKIE_NAME=bg03_token

# Origen exacto del frontend para CORS y cookies.
FRONTEND_URL=http://localhost:5173

# Credenciales iniciales del Administrador creado por el seed.
ADMIN_EMAIL=admin@biblioteca.ug.edu.ec
ADMIN_PASSWORD=cambia_esta_clave_de_admin
